<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <RunCodeAnalysis>false</RunCodeAnalysis>
        <RunAnalyzers>true</RunAnalyzers>
        <RootNamespace>VirtualClient.Dependencies</RootNamespace>
        <NoWarn>AsyncFixer02;SA1025;SA1116;SA1118</NoWarn>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit3TestAdapter" />
	</ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\VirtualClient.Dependencies\VirtualClient.Dependencies.csproj" />
        <ProjectReference Include="..\VirtualClient.TestExtensions\VirtualClient.TestExtensions.csproj" />
    </ItemGroup>

	<ItemGroup>
		<None Include="..\TestResources\**\*">
			<Link>TestResources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>

	<!--
    Copies example resources into the target output directory.
    -->
	<Target Name="CopyExamplesToOutputDirectory" AfterTargets="Build">
		<ItemGroup>
			<TestExampleFiles Include="Examples\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(TestExampleFiles)" DestinationFiles="@(TestExampleFiles->'$(OutputPath)test_examples\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

	<!--
    Copies test resources into the target output directory.
    -->
	<Target Name="CopyTestResourcesToOutputDirectory" AfterTargets="Build">
		<ItemGroup>
			<TestResourceFiles Include="..\TestResources\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(TestResourceFiles)" DestinationFiles="@(TestResourceFiles->'$(OutputPath)test_resources\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

    <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), Module.props))\Module.props" />

</Project>
