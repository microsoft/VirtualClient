{
    "Description": "Installs a certificate from a target Key Vault.",
    "Metadata": {
        "SupportedPlatforms": "linux-x64,linux-arm64,win-x64,win-arm64",
        "SupportedOperatingSystems": "AmazonLinux,AzureLinux,CentOS,Debian,OpenSuse,RedHat,Ubuntu,Windows"
    },
    "Parameters": {
        "CertificateName": null,
        "AccessToken": null,
        "TenantId": null,
        "FilePath": null
    },
    "Actions": [
        {
            "Type": "CertificateInstallation",
            "Parameters": {
                "Scenario": "InstallCertificate",
                "CertificateName": "$.Parameters.CertificateName",
                "AccessToken": "$.Parameters.AccessToken",
                "FilePath": "$.Parameters.FilePath",
                "TenantId": "$.Parameters.TenantId"
            }
        }
    ]
}
  