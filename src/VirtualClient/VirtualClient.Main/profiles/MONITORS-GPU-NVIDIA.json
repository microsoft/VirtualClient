{
    "Description": "Default Monitors for Nvidia GPU systems.",
    "Metadata": {
        "SupportedPlatforms": "linux-x64,linux-arm64,win-x64",
        "SupportedOperatingSystems": "CentOS,Debian,OpenSuse,RedHat,Ubuntu,Windows",
        "PreliminaryRequirements": "Please note that the Nvidia GPU driver and CUDA toolsets MUST be already installed on the system for the monitors to function correctly."
    },
    "ParameterAliases": {
        "MonitorIterations": "MonitorIterationCount"
    },
    "Parameters": {
        "MonitorFrequency": "00:01:00",
        "MonitorWarmupPeriod": "00:01:00",
        "MonitorIterationCount": -1
    },
    "Monitors": [
        {
            "Type": "NvidiaSmiMonitor",
            "Parameters": {
                "Scenario": "CaptureNvidiaSmiCounters",
                "MonitorFrequency": "$.Parameters.MonitorFrequency",
                "MonitorWarmupPeriod": "$.Parameters.MonitorWarmupPeriod",
                "MonitorIterationCount": "$.Parameters.MonitorIterationCount",
                "SupportedPlatforms": "linux-arm64,linux-x64,win-x64"
            }
        }
    ]
}