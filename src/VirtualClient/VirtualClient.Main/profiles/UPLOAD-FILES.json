{
    "Description": "Uploads files from a directory to a content store location.",
    "Metadata": {
        "SupportedPlatforms": "linux-x64,linux-arm64,win-x64,win-arm64",
        "SupportedOperatingSystems": "AmazonLinux,AzureLinux,CentOS,Debian,OpenSuse,RedHat,Ubuntu,Windows"
    },
    "Parameters": {
        "TargetDirectory": null,
        "FlattenStructure": false
    },
    "Actions": [
        {
            "Type": "WaitExecutor",
            "Parameters": {
                "Scenario": "Finalize",
                "Duration": "00:00:01"
            }
        }
    ],
    "Dependencies": [
        {
            "Type": "UploadFiles",
            "Parameters": {
                "Scenario": "UploadFiles",
                "TargetDirectory": "$.Parameters.TargetDirectory",
                "Flatten": "$.Parameters.FlattenStructure"
            }
        }
    ]
}