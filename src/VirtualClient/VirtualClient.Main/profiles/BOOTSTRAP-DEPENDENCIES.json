{
    "Description": "Installs dependencies from the package store.",
    "Metadata": {
        "SupportedPlatforms": "linux-x64,linux-arm64,win-x64,win-arm64",
        "SupportedOperatingSystems": "AmazonLinux,AzureLinux,CentOS,Debian,OpenSuse,RedHat,Ubuntu,Windows"
    },
    "Parameters": {
        "Package": null,
        "RegisterAsName": null
    },
    "Dependencies": [
        {
            "Type": "DependencyPackageInstallation",
            "Parameters": {
                "Scenario": "InstallDependencies",
                "BlobContainer": "packages",
                "BlobName": "$.Parameters.Package",
                "PackageName": "$.Parameters.RegisterAsName",
                "Extract": true
            }
        }
    ]
}