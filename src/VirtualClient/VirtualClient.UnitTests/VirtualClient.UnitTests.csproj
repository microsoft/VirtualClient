<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <RunCodeAnalysis>false</RunCodeAnalysis>
        <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>

    <ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\VirtualClient.Actions\VirtualClient.Actions.csproj" />
        <ProjectReference Include="..\VirtualClient.Contracts\VirtualClient.Contracts.csproj" />
        <ProjectReference Include="..\VirtualClient.Main\VirtualClient.Main.csproj" />
        <ProjectReference Include="..\VirtualClient.TestExtensions\VirtualClient.TestExtensions.csproj" />
    </ItemGroup>

	<ItemGroup>
		<None Include="..\TestResources\**\*">
			<Link>TestResources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>

	<!--
    Copies test resources into the target output directory.
    -->
	<Target Name="CopyProfilesToOutputDirectory" AfterTargets="Build">
		<ItemGroup>
			<ProfileFiles Include="profiles\*.*" />
			<ProfileFiles Include="..\VirtualClient.Main\profiles\MONITORS-DEFAULT.json" />
		</ItemGroup>

		<Copy SourceFiles="@(ProfileFiles)" DestinationFiles="@(ProfileFiles->'$(OutputPath)profiles\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
	
	<!--
    Copies test resources into the target output directory.
    -->
	<Target Name="CopyResourcesToOutputDirectory" AfterTargets="Build">
		<ItemGroup>
			<ResourceFiles Include="Resources\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(ResourceFiles)" DestinationFiles="@(ResourceFiles->'$(OutputPath)test_resources\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

    <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), Module.props))\Module.props" />

</Project>
